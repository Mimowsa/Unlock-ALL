# Phases 3/4: server-only configuration. Never use NEXT_PUBLIC_ for these values.
# For local PostgreSQL with private generated secrets: npm run db:local:start
# For Neon: use a dedicated development branch and copy its connection strings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional: a separate, disposable database used only by prisma migrate dev.
# Never set this to DATABASE_URL or DIRECT_URL.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@SHADOW_HOST/SHADOW_DATABASE?sslmode=require"

# Seed is opt-in and refused when NODE_ENV or VERCEL_ENV is production.
APP_MODE=demo
DEMO_SEED_ENABLED=false
# Explicitly enable demo checkout only together with APP_MODE=demo and SiteSetting.demoEnabled=true.
DEMO_CHECKOUT_ENABLED=false

# Each secret must be an independent, random 32-byte value (64 hex characters).
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never reuse these example placeholders. Back up the keys separately from the DB.
ACTIVATION_KEY_KEY_ID=v1
ACTIVATION_KEY_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ACTIVATION_KEY_FINGERPRINT_SECRET=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS

# Authentication: canonical origin, including the development port.
# Generate private local defaults: npm run auth:configure
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# 'local' writes reset links to a private developer mailbox only in development.
# Production/Vercel never enables that mailbox. For Resend, use the phase 8 settings below.
AUTH_RESET_DELIVERY=none
# Optional private filesystem path, never under public/.
# AUTH_LOCAL_MAILBOX_DIR=/private/path/to/development-reset-mailbox

# Optional persistent directory for local product image uploads.
# Default: .local/product-images. Vercel requires vercel-blob (private store).
PRODUCT_IMAGE_STORAGE=local
# BLOB_READ_WRITE_TOKEN=
# PRODUCT_IMAGES_DIR=/private/path/to/product-images

# Phase 8: explicit test delivery. Restricted to this Resend account address.
# Keep the API key server-only; never commit or use a NEXT_PUBLIC_ prefix.
EMAIL_DELIVERY=none
RESEND_API_KEY=
EMAIL_TEST_RECIPIENT=
# Local configuration: npm run email:configure -- --recipient=you@example.com
# The test sender is UNLOCK-ALL <onboarding@resend.dev>.
# AUTH_RESET_DELIVERY=email is set by the local configuration command.

# Phase 9: only PayPal Sandbox is supported; live is rejected.
PAYPAL_ENV=sandbox
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Configure this only after registering your public HTTPS webhook for this app.
PAYPAL_WEBHOOK_ID=

# Phase 11: protected scheduler endpoints; disabled locally by default.
BACKGROUND_JOBS_ENABLED=false
CRON_SECRET=
# For hosted configuration, see .env.vercel.example and docs/phase-11.md.
