{
  "name": "unlock-all",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/engine.test.ts tests/key-vault.test.ts tests/email.test.ts tests/paypal.test.ts tests/deployment.test.ts",
    "test:e2e": "node scripts/test-browser.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:check": "node --experimental-strip-types scripts/check-database.ts",
    "db:studio": "prisma studio --port 5555",
    "db:local:start": "node scripts/local-database.mjs start",
    "db:local:stop": "node scripts/local-database.mjs stop",
    "test:db": "node --experimental-strip-types --test tests/database.test.ts",
    "test:security": "node --experimental-strip-types --test tests/key-vault.test.ts",
    "auth:configure": "node scripts/configure-auth.mjs",
    "auth:admin": "node --experimental-strip-types scripts/provision-admin.ts",
    "auth:cleanup": "node --experimental-strip-types scripts/cleanup-auth.ts",
    "demo:configure": "node scripts/configure-demo.mjs",
    "email:worker": "node --experimental-strip-types scripts/email-worker.ts",
    "email:configure": "node scripts/configure-email.mjs",
    "email:test": "node --experimental-strip-types scripts/test-email.ts",
    "email:preview": "node --experimental-strip-types scripts/preview-emails.ts",
    "paypal:configure": "node --experimental-strip-types scripts/configure-paypal.ts",
    "paypal:check": "node --experimental-strip-types scripts/check-paypal.ts",
    "paypal:reconcile": "node --experimental-strip-types scripts/reconcile-paypal.ts",
    "deploy:check": "node --experimental-strip-types scripts/check-deployment.ts",
    "build:vercel": "npm run deploy:check && npm run build",
    "deploy:database": "node --experimental-strip-types scripts/prepare-hosted-database.ts",
    "deploy:bootstrap": "node --experimental-strip-types scripts/bootstrap-hosted-demo.ts",
    "deploy:verify": "node --experimental-strip-types scripts/verify-hosted-deployment.ts",
    "paypal:reference:configure": "node --experimental-strip-types scripts/configure-paypal-reference.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "@vercel/blob": "2.8.2",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
